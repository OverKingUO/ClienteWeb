// ===================================================|
// MACRO: Mover objetos                               |
// Versión: 6.3 || Autor: Over (Barack Segoviain)     |
// ===================================================|
//
// ___________________________________________________
// CONFIGURACIÓN DEL USUARIO                          |
//                                                    |
const FILTRAR_POR_HUE: 'SI' | 'NO' = 'SI';
// "NO" → mueve los items sin importar su color       |
//                                                    |
const IDENTIFICAR_GRAPHICS: 'SI' | 'NO' = 'NO';
// "SI" → tira un item al suelo para ver sus graphics |
//                                                    |
// ___________________________________________________|


// ====================================================
// BLOQUE 2 — CONSTANTES INTERNAS (MODIFICAR CON CUIDADO)
// ====================================================

const SLEEP_MOVE          = 150;
const SLEEP_CONTENEDOR    = 1200;

// Tiempo de espera al detectar el cooldown de "coger" del juego
// ("No puedes coger eso"). Se multiplica por el nº de fallo consecutivo
// (1º fallo = 1×, 2º = 2×...). Bájalo si te parece demasiado lento.
const SLEEP_REINTENTO_LIFT = 300;

// Tiempo de espera ante un rechazo genérico (no identificado como
// cooldown de lift). Mismo sistema de multiplicación por intento.
const SLEEP_REINTENTO_GENERICO = 400;
const SLEEP_CONFIRMACION = 400;
const SLEEP_SUELO        = 800;   // espera tras tirar al suelo para escanear

// Confirmación activa: en vez de esperar siempre un tiempo fijo, se
// comprueba cada POLL_INTERVAL si el movimiento ya se confirmó, hasta
// un máximo de TIMEOUT_MOVE_CONFIRM.
const POLL_INTERVAL        = 80;
const TIMEOUT_MOVE_CONFIRM = 2500;

// Límite real de UO: un contenedor no admite más de 255 items distintos
// (slots). En items NO stackeables cada unidad ocupa un slot propio.
const LIMITE_CONTENEDOR = 255;

// Mensajes conocidos del servidor
const MSG_CONTENEDOR_LLENO = "Demasiados objetos en este contenedor.";
const MSG_NO_PUEDES_COGER  = "No puedes coger eso";


// ====================================================
// BLOQUE 3 — UTILIDADES
// ====================================================

function warn(msg: string): void { client.sysMsg(`⚠️ ${msg}`, 0x35); }   // Advertencia — amarillo
function err(msg: string):  void { client.sysMsg(`❌ ${msg}`, 0x26); }   // Error — rojo
function ok(msg: string):   void { client.sysMsg(`✅ ${msg}`, 0x44); }   // Acierto — verde
function info(msg: string): void { client.sysMsg(`ℹ️ ${msg}`, 0x5A); }   // Info — azul
function run(msg: string):  void { client.sysMsg(`⚙️ ${msg}`, 0x00); }   // Funcionamiento — blanco

// Metadatos del script — se leen de la cabecera del propio archivo.
// Cámbialos aquí si cambias nombre/versión/autor, para que el mensaje
// de inicio siempre esté sincronizado con el comentario de arriba.
const SCRIPT_NOMBRE  = "Mover objetos";
const SCRIPT_VERSION = "6.3";
const SCRIPT_AUTOR   = "Over";

run(`[▶ script iniciado] ${SCRIPT_NOMBRE} v${SCRIPT_VERSION} by ${SCRIPT_AUTOR}`);

function estaEnMochila(serial: number): boolean {
  if (!player.backpack) return false;
  if (serial === player.backpack.serial) return true;
  const obj = client.findObject({ serial }, null, player.backpack);
  return !!obj;
}

// Cuenta cuántos items (slots) hay YA dentro de un contenedor. Es una
// lectura local (sin tráfico de red), así que se puede llamar en cada
// iteración del bucle sin coste.
function contarItemsEnContenedor(serial: number): number {
  const cont = client.findObject({ serial }) as Item | null;
  if (!cont || !Array.isArray((cont as any).contents)) return 0;
  return (cont as any).contents.length;
}


// ====================================================
// BLOQUE 4 — SELECCIÓN DE CONTENEDORES Y OBJETO
// ====================================================

// ── Paso 1: Contenedor origen ───────────────────────────────

warn("1/3 — Haz clic en el contenedor ORIGEN...");
const selOrigen = target.query(false);
if (!selOrigen?.serial) { err("Selección cancelada."); exit(); }
const serialOrigen = selOrigen.serial;

player.use(serialOrigen);
sleep(SLEEP_CONTENEDOR);
info("Origen registrado.");

// ── Paso 2: Objeto a mover ──────────────────────────────────

warn("2/3 — Haz clic en el OBJETO que quieres mover (debe estar en el origen)...");
const selObjeto = target.query(false);
if (!selObjeto?.serial) { err("Selección cancelada."); exit(); }

const graphicInicial = selObjeto.graphic;
const hueObjetivo    = selObjeto.hue ?? 0;
const serialObjeto   = selObjeto.serial;

if (!graphicInicial) {
  err("No se pudo obtener el graphic del objeto seleccionado.");
  exit();
}

info(`Graphic inicial: 0x${graphicInicial.toString(16).toUpperCase()}${FILTRAR_POR_HUE === 'SI' ? ` | Hue: 0x${hueObjetivo.toString(16).toUpperCase()}` : " | Sin filtro de hue"}`);

// ── Paso 3: Contenedor destino ──────────────────────────────

warn("3/3 — Haz clic en el contenedor DESTINO...");
const selDestino = target.query(false);
if (!selDestino?.serial) { err("Selección cancelada."); exit(); }
const serialDestino = selDestino.serial;

if (serialDestino === serialOrigen) {
  err("El destino no puede ser el mismo que el origen.");
  exit();
}

info("Destino registrado.");

const itemsIniciales = contarItemsEnContenedor(serialDestino);
if (itemsIniciales >= LIMITE_CONTENEDOR) {
  err("El destino ya está lleno (255 items). Macro detenida.");
  exit();
}


// ====================================================
// BLOQUE 5 — DESCUBRIMIENTO DE GRAPHICS ALTERNATIVOS
// ====================================================
//
// Al caer al suelo algunos items cambian de orientación y por tanto de graphic.
// Para moverlos todos necesitamos conocer todos los graphics posibles.
//
// Clave: el SERIAL del item nunca cambia aunque cambie el graphic.
// Tiramos el item al suelo, lo buscamos por SERIAL para leer su nuevo graphic,
// lo recogemos, lo volvemos a tirar, y repetimos hasta que el graphic vuelva
// al inicial (ciclo completo). Nunca buscamos por graphic en el suelo.
//
// Si IDENTIFICAR_GRAPHICS = "NO", se salta todo esto: no se tira nada al
// suelo y solo se usa el graphic inicial seleccionado.

let todosGraphics: number[];

if (IDENTIFICAR_GRAPHICS === 'SI') {
  const graphicsConocidos: Set<number> = new Set([graphicInicial]);

  info("Comprobando graphics alternativos...");

  let itemParaTirar = client.findType(
    graphicInicial,
    FILTRAR_POR_HUE === 'SI' ? hueObjetivo : null,
    { serial: serialOrigen }, null, 0
  ) as Item | null;

  if (!itemParaTirar) {
    err("No se encontró el objeto en el origen para comprobar sus graphics.");
    exit();
  }

  const serialDelItem = itemParaTirar.serial;

  player.moveItemOnGroundOffset(itemParaTirar, 0, 0, 0, 1);
  sleep(SLEEP_SUELO);

  let intentos = 0;

  while (intentos < 10) {
    const itemAhora = client.findObject({ serial: serialDelItem }) as Item | null;
    if (!itemAhora) { err("Perdí el rastro del item. Abortando detección."); break; }

    const graphicActual = itemAhora.graphic;

    if (!graphicsConocidos.has(graphicActual)) {
      graphicsConocidos.add(graphicActual);
      info(`Graphic alternativo: 0x${graphicActual.toString(16).toUpperCase()}`);
    }

    if (intentos > 0 && graphicActual === graphicInicial) {
      info("Ciclo de graphics completo.");
      break;
    }

    player.moveItem(itemAhora, player.backpack!, 0, 0, 0, 1);
    sleep(SLEEP_SUELO);

    const enMochila = client.findObject({ serial: serialDelItem }) as Item | null;
    if (!enMochila) break;
    player.moveItemOnGroundOffset(enMochila, 0, 0, 0, 1);
    sleep(SLEEP_SUELO);

    intentos++;
  }

  todosGraphics = Array.from(graphicsConocidos);
  info(`Graphics totales: ${todosGraphics.map(g => "0x" + g.toString(16).toUpperCase()).join(", ")}`);

  {
    const itemAhora = client.findObject({ serial: serialDelItem }) as Item | null;
    if (itemAhora) {
      player.moveItem(itemAhora, { serial: serialDestino }, 0, 0, 0, 1);
      sleep(SLEEP_MOVE);
      info("Primer item enviado al destino.");
    }
  }
} else {
  todosGraphics = [graphicInicial];
}


// ====================================================
// BLOQUE 6 — CÁLCULO DE DIRECCIÓN Y PESO REAL
// ====================================================
//
// 3 escenarios posibles según dónde estén origen y destino:
//
//  1) destino = mi mochila, origen ≠ mi mochila → mi peso SUBE.
//     Límite: mi weightMax - peso actual (lo que realmente puedo cargar).
//
//  2) origen = mi mochila (destino no) o ambos dentro de mi mochila →
//     el objeto YA está contado en mi peso actual, así que sacarlo o
//     reordenarlo nunca puede superar mi capacidad. Sin límite de peso.
//
//  3) ninguno es mi mochila (contenedor externo → contenedor externo,
//     ej. bolsa hija → cofre padre) → no cargo el peso en mi inventario,
//     pero UO sí limita cuánto puedo "arrastrar" de una vez: el TRIPLE
//     de mi peso máximo real.

const origenEnMochila  = estaEnMochila(serialOrigen);
const destinoEnMochila = estaEnMochila(serialDestino);
const pesoSube          = !origenEnMochila && destinoEnMochila;
const ambosExternos     = !origenEnMochila && !destinoEnMochila;

let pesoUnaUnidad = 1; // fallback si no se puede medir

if (pesoSube || ambosExternos) {
  let itemMedicion: Item | null = null;
  for (const g of todosGraphics) {
    const candidato = client.findType(g, FILTRAR_POR_HUE === 'SI' ? hueObjetivo : null, { serial: serialOrigen }, null, 0) as Item | null;
    if (candidato) { itemMedicion = candidato; break; }
  }

  if (itemMedicion && itemMedicion.amount > 1) {
    // Solo merece la pena medir si es un stack real (>1 unidad). Si el
    // ítem no es stackeable, cada movimiento va a ser de 1 unidad de
    // todas formas — medir solo añadía un viaje de ida y vuelta que a
    // veces dejaba un ítem huérfano en la mochila si algo fallaba.
    const serialMedicion = itemMedicion.serial;
    const pesoAntes = player.weight;

    player.moveItem(itemMedicion, player.backpack!, 0, 0, 0, 1);

    const inicioMedicion = Date.now();
    while (player.weight === pesoAntes && Date.now() - inicioMedicion < 2000) {
      sleep(100);
    }

    const deltaPeso = player.weight - pesoAntes;

    if (deltaPeso > 0) {
      pesoUnaUnidad = deltaPeso;
      info(`Peso real del objeto: ${pesoUnaUnidad} unidad/es.`);

      if (pesoSube) {
        info("Primer item ya está en el destino (mi mochila).");
      } else {
        const enMochila = client.findObject({ serial: serialMedicion }, null, player.backpack) as Item | null;
        if (enMochila) {
          player.moveItem(enMochila, { serial: serialDestino }, 0, 0, 0, 1);
          sleep(SLEEP_MOVE);
          info("Primer item enviado al destino tras medir su peso.");
        }
      }
    } else if (deltaPeso < 0) {
      err("El item cayó al suelo durante la medición de peso. Buscando y recuperando...");

      let recuperado = false;
      for (const g of todosGraphics) {
        const enSuelo = client.findType(g, null, null, null, 3) as Item | null;
        if (enSuelo && (enSuelo as any).container === -1) {
          player.moveItem(enSuelo, { serial: serialOrigen }, 0, 0, 0, 1);
          sleep(SLEEP_MOVE);
          recuperado = true;
          break;
        }
      }
      if (!recuperado) err("No se pudo recuperar el item del suelo. Continúa con precaución.");
    } else {
      err("El item no llegó a mi mochila durante la medición. Puede que esté en el suelo.");
      for (const g of todosGraphics) {
        const enSuelo = client.findType(g, null, null, null, 3) as Item | null;
        if (enSuelo && (enSuelo as any).container === -1) {
          player.moveItem(enSuelo, { serial: serialOrigen }, 0, 0, 0, 1);
          sleep(SLEEP_MOVE);
          break;
        }
      }
    }
  } else if (itemMedicion) {
    // objeto no stackeable (o solo queda 1 unidad) — se omite la medición
  }
}


// ====================================================
// BLOQUE 7 — BÚSQUEDA EN ORIGEN (TODOS LOS GRAPHICS)
// ====================================================

function buscarEnOrigen(): Item[] {
  const resultado: Item[] = [];
  for (const g of todosGraphics) {
    const items = client.findAllItemsOfType(g, null, { serial: serialOrigen }, null, 0) as Item[];
    const filtrados = FILTRAR_POR_HUE === 'SI' ? items.filter(it => it.hue === hueObjetivo) : items;
    resultado.push(...filtrados);
  }
  return resultado;
}


// ====================================================
// BLOQUE 8 — BUCLE DE MOVIMIENTO
// ====================================================

function recuperarPorContenedorLleno(serialItem: number): void {
  err(`El destino está lleno ("${MSG_CONTENEDOR_LLENO}"). Recuperando el item...`);
  const encontrado = client.findObject({ serial: serialItem }) as Item | null;
  if (!encontrado) {
    err("No se encontró el item para devolverlo al origen. Revísalo manualmente.");
    return;
  }
  player.moveItem(encontrado, { serial: serialOrigen }, 0, 0, 0, encontrado.amount);
  sleep(SLEEP_MOVE);
  info("Item devuelto al origen.");
}

run("Iniciando movimiento...");
let movidos = 0;         // nº de operaciones de movimiento (iteraciones)
let unidadesTotales = 0; // nº real de objetos transferidos (suma de cantidades)
let parado  = false;
let fallosConsecutivos = 0;

while (true) {
  // Comprobamos primero si queda algo por mover — si no queda nada,
  // es un final normal con éxito, sin importar en qué número esté el
  // destino (podría haber llegado justo a 255 con el último movimiento).
  const items = buscarEnOrigen();
  if (items.length === 0) break;

  const itemsEnDestino = contarItemsEnContenedor(serialDestino);
  if (itemsEnDestino >= LIMITE_CONTENEDOR) {
    err(`El destino ha llegado al límite de ${LIMITE_CONTENEDOR} items. Aún quedan objetos sin mover en el origen. Macro detenida.`);
    parado = true;
    break;
  }

  const item = items[0];
  const serialItemActual = item.serial;
  const amountAntes = item.amount;

  journal.clear();

  let aMover = item.amount;

  if (pesoSube || ambosExternos) {
    const limiteArrastre = (3 * player.weightMax) - player.weight;
    const limitePeso = pesoSube
      ? Math.max(0, player.weightMax - player.weight - 1)
      : Math.max(0, limiteArrastre - 1);

    if (limitePeso < pesoUnaUnidad) {
      if (pesoSube) {
        err(`Límite de peso alcanzado (${player.weight}/${player.weightMax}). Macro detenida.`);
      } else {
        err(`Capacidad de arrastre alcanzada (3×${player.weightMax} - ${player.weight} = ${limiteArrastre}). Macro detenida.`);
      }
      parado = true;
      break;
    }

    const unidadesMaxPorPeso = Math.floor(limitePeso / pesoUnaUnidad);
    aMover = Math.min(item.amount, Math.max(1, unidadesMaxPorPeso));
  }

  const pesoAntes = player.weight;
  player.moveItem(item, { serial: serialDestino }, 0, 0, 0, aMover);
  sleep(SLEEP_MOVE);

  // ── Confirmación del movimiento ──
  // Una sola fuente de verdad: el propio bucle de polling marca
  // 'confirmado', comprobando dos señales (desaparece del origen O
  // aparece en el destino, lo que llegue antes).
  let confirmado = false;

  if (pesoSube) {
    const inicio = Date.now();
    while (player.weight === pesoAntes && Date.now() - inicio < 2000) {
      sleep(100);
    }
    sleep(SLEEP_CONFIRMACION);
    confirmado = player.weight !== pesoAntes;
  } else {
    const inicioPoll = Date.now();
    while (Date.now() - inicioPoll < TIMEOUT_MOVE_CONFIRM) {
      const enOrigen = client.findObject({ serial: serialItemActual }, null, { serial: serialOrigen }) as Item | null;
      if (!enOrigen || enOrigen.amount !== amountAntes) { confirmado = true; break; }

      const enDestino = client.findObject({ serial: serialItemActual }, null, { serial: serialDestino }) as Item | null;
      if (enDestino) { confirmado = true; break; }

      sleep(POLL_INTERVAL);
    }
  }

  if (journal.containsText(MSG_CONTENEDOR_LLENO)) {
    recuperarPorContenedorLleno(serialItemActual);
    parado = true;
    break;
  }

  const rechazoLift = journal.containsText(MSG_NO_PUEDES_COGER);

  if (pesoSube && !confirmado) {
    err("El item no llegó al destino (posiblemente cayó al suelo). Buscando...");
    let recuperado = false;
    for (const g of todosGraphics) {
      const enSuelo = client.findType(g, null, null, null, 3) as Item | null;
      if (enSuelo && (enSuelo as any).container === -1) {
        info("Item encontrado en el suelo. Devolviéndolo al origen...");
        player.moveItem(enSuelo, { serial: serialOrigen }, 0, 0, 0, 1);
        sleep(SLEEP_MOVE);
        recuperado = true;
        break;
      }
    }
    if (!recuperado) err("No se encontró el item en el suelo. Macro detenida.");
    parado = true;
    break;
  }

  if (!pesoSube) {
    if (!confirmado) {
      fallosConsecutivos++;
      if (fallosConsecutivos >= 5) {
        err(`El item sigue sin moverse tras ${fallosConsecutivos} intentos. Macro detenida.`);
        parado = true;
        break;
      }
      if (rechazoLift) {
        warn(`Cooldown de "coger" del juego. Esperando antes de reintentar (${fallosConsecutivos}/5)...`);
        sleep(SLEEP_REINTENTO_LIFT * fallosConsecutivos);
      } else {
        warn(`El servidor rechazó el movimiento. Esperando antes de reintentar (${fallosConsecutivos}/5)...`);
        sleep(SLEEP_REINTENTO_GENERICO * fallosConsecutivos);
      }
    } else {
      fallosConsecutivos = 0;
      movidos++;
      unidadesTotales += aMover;
      sleep(SLEEP_MOVE);
    }
    continue;
  }

  movidos++;
  unidadesTotales += aMover;
  sleep(SLEEP_MOVE);
}

// ── Fin ─────────────────────────────────────────────────────

if (!parado) {
  if (movidos === 0) {
    err("No se encontraron items del tipo indicado en el origen.");
  } else if (unidadesTotales !== movidos) {
    ok(`Completado. Movimientos realizados: ${movidos}. Objetos movidos: ${unidadesTotales}.`);
  } else {
    ok(`Completado. Objetos movidos: ${unidadesTotales}.`);
  }
}
